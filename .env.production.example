# Producción: Dokploy compila directamente desde el repositorio con compose.production.yaml.
# Copiar valores a Environment de Dokploy. .env.production es privado y no se sube a Git.
# Un solo arranque completo: docker compose --env-file .env.production -f compose.production.yaml up -d --build
POSTGRES_IMAGE=postgres:17
PUBLIC_SITE_URL=https://lumio-catalog.escod.com.gt
ODOO_PUBLIC_URL=https://lumio-odoo.escod.com.gt
LUMIO_CATALOG_ID=lumio-escod-production
# Logo obtenido del sitio Odoo; respaldo opcional vacío a propósito.
LUMIO_LOGO_URL=
LUMIO_PRIMARY_COLOR="#234d46"
# API interna: el build Angular consulta GraphQL después de iniciar el backend.
ODOO_URL=http://odoo:8069
ODOO_DATABASE=lumio_production
# Vacíos: bootstrap genera una clave válida y obtiene IDs reales automáticamente.
# Completar IDs solo para seleccionar un registro cuando existan varios; no reutilizar la demo.
ODOO_API_KEY=
ODOO_WEBSITE_ID=
ODOO_PRICELIST_ID=
ODOO_WAREHOUSE_ID=
ODOO_STOCK_POLICY=FREE_STOCK
ODOO_LANGUAGE=es_ES
ODOO_CAMPAIGNS_ENABLED=true
ODOO_BUSINESS_NAME=Lumio
ODOO_BUSINESS_DESCRIPTION=Consulta el catálogo de Lumio y prepara tu pedido.
# Vacío deshabilita WhatsApp hasta configurar el número real del negocio.
ODOO_WHATSAPP_NUMBER=
ODOO_CONNECT_TIMEOUT_MS=3000
ODOO_REQUEST_TIMEOUT_MS=10000
ODOO_MAX_RECORDS=5000
ODOO_MAX_IMAGE_BYTES=4000000
# Contraseñas distintas: generar en .env.production, nunca en esta plantilla.
POSTGRES_ADMIN_USER=lumio_db_admin
POSTGRES_ADMIN_PASSWORD=
ODOO_DB_USER=lumio_odoo
ODOO_DB_PASSWORD=
ODOO_MASTER_PASSWORD=
# Solo inicialización administrativa, no se inyectan en servicios normales.
ODOO_ADMIN_LOGIN=lumio-admin
ODOO_ADMIN_PASSWORD=
LUMIO_BUSINESS_NAME=Lumio
# Solo la primera instalación; después se conserva la moneda configurada en Odoo.
LUMIO_CURRENCY=GTQ
# Límites iniciales; ajustar según recursos del servidor y carga real.
ODOO_WORKERS=2
ODOO_CRON_THREADS=1
ODOO_WORKER_MEMORY_SOFT=536870912
ODOO_WORKER_MEMORY_HARD=805306368
ODOO_MEMORY=2g
POSTGRES_MEMORY=512m
LUMIO_CORE_MEMORY=768m
LUMIO_STOREFRONT_MEMORY=128m
LUMIO_BUILD_MEMORY=2g
