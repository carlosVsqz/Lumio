FROM node:24-bookworm-slim AS build-tools
WORKDIR /workspace/lm-storefront
COPY lm-storefront/package.json lm-storefront/package-lock.json ./
RUN npm ci
COPY lm-storefront ./
COPY scripts/release-config.mjs scripts/dokploy-prerender.mjs /opt/lumio/
RUN npm test && mkdir -p /static && chown -R node:node /workspace /opt/lumio /static
USER node
CMD ["node", "/opt/lumio/dokploy-prerender.mjs"]

FROM nginx:stable-alpine AS storefront
COPY lm-storefront/nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's@root /usr/share/nginx/html;@root /usr/share/nginx/html/current;@' /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
