<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="campaign_privilege" model="res.groups.privilege">
    <field name="name">Campañas de Lumio</field>
    <field name="category_id" ref="base.module_category_website"/>
    <field name="sequence">24</field>
  </record>
  <record id="group_campaign_reader" model="res.groups">
    <field name="name">Lumio: lectura de campañas (API)</field>
    <field name="privilege_id" ref="campaign_privilege"/>
    <field name="sequence">10</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_campaign_manager" model="res.groups">
    <field name="name">Lumio: gestión de campañas</field>
    <field name="privilege_id" ref="campaign_privilege"/>
    <field name="sequence">20</field>
    <field name="implied_ids" eval="[(4, ref('group_campaign_reader'))]"/>
  </record>
  <record id="campaign_company_rule" model="ir.rule">
    <field name="name">Lumio: campañas de compañías permitidas</field>
    <field name="model_id" ref="model_lumio_campaign_slide"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
