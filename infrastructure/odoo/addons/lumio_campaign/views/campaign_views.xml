<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="campaign_list" model="ir.ui.view">
    <field name="name">lumio.campaign.slide.list</field>
    <field name="model">lumio.campaign.slide</field>
    <field name="arch" type="xml">
      <list default_order="sequence,id">
        <field name="sequence" widget="handle"/>
        <field name="title"/>
        <field name="website_id"/>
        <field name="is_published"/>
        <field name="starts_at"/>
        <field name="ends_at"/>
        <field name="active" column_invisible="True"/>
      </list>
    </field>
  </record>
  <record id="campaign_form" model="ir.ui.view">
    <field name="name">lumio.campaign.slide.form</field>
    <field name="model">lumio.campaign.slide</field>
    <field name="arch" type="xml">
      <form string="Campaña del escaparate">
        <sheet>
          <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
          <group>
            <group><field name="title"/><field name="message"/><field name="action_label"/><field name="action_url"/></group>
            <group><field name="website_id"/><field name="company_id" invisible="1"/><field name="sequence"/><field name="is_published"/><field name="starts_at"/><field name="ends_at"/><field name="utm_campaign_id"/><field name="active" invisible="1"/></group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="campaign_search" model="ir.ui.view">
    <field name="name">lumio.campaign.slide.search</field>
    <field name="model">lumio.campaign.slide</field>
    <field name="arch" type="xml">
      <search><field name="title"/><field name="website_id"/><filter name="published" string="Publicados" domain="[('is_published', '=', True)]"/><separator/><filter name="archived" string="Archivados" domain="[('active', '=', False)]"/></search>
    </field>
  </record>
  <record id="campaign_action" model="ir.actions.act_window">
    <field name="name">Campañas del escaparate</field>
    <field name="res_model">lumio.campaign.slide</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_lumio" name="Lumio" groups="group_campaign_manager" sequence="90"/>
  <menuitem id="menu_campaigns" name="Campañas del escaparate" parent="menu_lumio" action="campaign_action" sequence="10" groups="group_campaign_manager"/>
</odoo>
