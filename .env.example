# Archivo leído por Spring; fuera de Docker puede usarse file:./ruta/catalogo.json.
# Entorno demo local aislado. scripts/Start-LumioDemo.ps1 genera .env y los secretos.
COMPOSE_PROJECT_NAME=lumio-demo-local
COMPOSE_PROFILES=odoo
CATALOG_PROVIDER=odoo
# Nombre exacto del atributo público de clasificación usado para las marcas.
CATALOG_BRAND_ATTRIBUTE=Marca
# ID estable del negocio, no secreto. Mantenerlo al mover el JSON; cambiarlo al cambiar de negocio.
LUMIO_CATALOG_ID=lumio-odoo-local-demo
# Identidad genérica. En Odoo prevalece website.logo; esta URL es respaldo si no hay logo.
LUMIO_LOGO_URL=
LUMIO_PRIMARY_COLOR=
CATALOG_LOCATION=file:/catalog/example.json
# Directorio del host que Compose monta en /catalog, solo lectura.
CATALOG_DIRECTORY=./lm-core/src/main/resources/catalog
# Configura nombre, descripción, moneda, decimales y WhatsApp dentro del JSON.
# Variables para npm run build:storefront: exportarlas en la terminal (.env no se carga automáticamente).
CATALOG_BUILD_API_URL=http://localhost:8080/graphql
PUBLIC_SITE_URL=http://localhost:8088

# Odoo 19 JSON-2: solo lm-core. Rellenar localmente; nunca publicar claves.
# Dentro de Compose se usa el nombre del servicio, no localhost.
# Para lm-core ejecutado fuera de Docker: http://localhost:8069.
ODOO_URL=http://odoo:8069
ODOO_DATABASE=lumio_demo
ODOO_API_KEY=
ODOO_WEBSITE_ID=1
ODOO_PRICELIST_ID=6
ODOO_WAREHOUSE_ID=4
ODOO_STOCK_POLICY=FREE_STOCK
ODOO_LANGUAGE=es_ES
# Habilitar después de instalar lumio_campaign y asignar permiso de lectura al usuario API.
ODOO_CAMPAIGNS_ENABLED=true
# Nombre vacío utiliza el nombre del sitio en Odoo.
ODOO_BUSINESS_NAME=
ODOO_BUSINESS_DESCRIPTION=Productos y servicios de una tienda de pruebas local administrada en Odoo.
# Vacío deshabilita WhatsApp; usar dígitos internacionales sin + ni espacios.
ODOO_WHATSAPP_NUMBER=
ODOO_CONNECT_TIMEOUT_MS=3000
ODOO_REQUEST_TIMEOUT_MS=10000
ODOO_MAX_RECORDS=5000
ODOO_MAX_IMAGE_BYTES=4000000

# Servicios Odoo/PostgreSQL locales: docker compose --profile odoo up -d odoo
# Completar la contraseña localmente antes de iniciar PostgreSQL.
# Esta contraseña conecta Odoo con PostgreSQL; NO es ODOO_API_KEY.
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=
ODOO_HTTP_PORT=8069
# Rutas relativas al compose.yaml. Crear los directorios y preparar odoo.conf.
ODOO_CONFIG_DIRECTORY=./infrastructure/odoo/local/config
ODOO_ADDONS_DIRECTORY=./infrastructure/odoo/local/addons
# Acceso administrativo local previsto; el script guarda el usuario y contraseña solo en .env.
ODOO_DEMO_ADMIN_LOGIN=
ODOO_DEMO_ADMIN_PASSWORD=
ODOO_DEMO_MASTER_PASSWORD=
